# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Harness run artifacts (logs/diffs per dispatch — not source)
runs/

# Bench-worker leftovers if cwd-isolation in scripts/token_efficiency.py ever
# regresses (mod_*.py + pipeline.py are synthesized task names from task_synth.py).
/mod_*.py
/pipeline.py

# Dashboard server.log + ad-hoc stub scripts that workers spawn during dispatch
# smoke-tests (caught these mid-build; harmless but noisy in git status).
/server.log
/stub_dispatch.py
# Stray `=<version>` files from misparsed `pip install foo>=X.Y` invocations.
/=[0-9]*

# Worker-CLI residue (agy drops a symlink into ~/.gemini)
.antigravitycli/
.tlica_state/

# Worker / agent config dirs — never commit these. They commonly hold session
# tokens, auth state, API keys, or symlinks into the user's home-dir secret
# stores. Blanket-block by directory pattern so a new tool dropping its
# config here can't silently leak. Add specific files back via !pattern if
# ever needed.
.claude/
.grok/
.codex/
.agy/
.anthropic/
.openai/
.xai/
.gemini/
*.token
*credentials*
*secret*

# Editors / OS
.idea/
.vscode/
.DS_Store
